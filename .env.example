# Copie este archivo como .env y ponga sus datos de MySQL.
# El archivo .env no se sube a GitHub.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coworking_db

# Clave para los mensajes de la aplicación web. Cualquier texto largo sirve.
FLASK_SECRET_KEY=cambie-esta-clave-por-una-propia
